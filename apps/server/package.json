{
  "name": "@llm-harness/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "yarn db:generate && tsc -p tsconfig.build.json",
    "db:generate": "node scripts/render-prisma-schemas.mjs && prisma generate --schema prisma/sqlite/schema.prisma && prisma generate --schema prisma/mysql/schema.prisma && prisma generate --schema prisma/postgresql/schema.prisma",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/infrastructure/database/migrate.ts",
    "db:migrate:sqlite": "prisma migrate deploy --config prisma/sqlite/prisma.config.ts",
    "db:migrate:mysql": "prisma migrate deploy --config prisma/mysql/prisma.config.ts",
    "db:migrate:postgresql": "prisma migrate deploy --config prisma/postgresql/prisma.config.ts",
    "test:integration": "bash scripts/test-databases.sh",
    "dev": "tsx --env-file-if-exists=../../.env watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "yarn db:generate && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@llm-harness/contracts": "workspace:*",
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.0.0",
    "mariadb": "^3.0.0",
    "pg": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "prisma": "7.9.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
