generator client {
  provider     = "prisma-client"
  output       = "__OUTPUT__"
  moduleFormat = "esm"
}

datasource db {
  provider = "__PROVIDER__"
}

model HarnessSettings {
  id                    String   @id
  currentWorkspaceId    String?
  currentModelProfileId String?
  currentModelName      String?
  currentToolIds        Json
  maxIterations         Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Workspace {
  id            String         @id
  name          String
  path          String         @unique
  status        String
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
}

model ModelProfile {
  id                String              @id
  displayName       String
  baseUrl           String
  secretSource      String
  secretReference   String
  maskedSecret      String
  connectionStatus  String
  connectionTestedAt DateTime?
  connectionLatencyMs Int?
  connectionError   Json?
  catalogRefreshedAt DateTime?
  catalogEntries    ModelCatalogEntry[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model ModelCatalogEntry {
  id        String       @id
  profileId String
  modelName String
  source    String
  profile   ModelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([profileId, modelName])
  @@index([profileId, source])
}

model Conversation {
  id           String          @id
  workspaceId  String
  title        String__LONG_TEXT__
  titleSource  String
  instructions String__LONG_TEXT__
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  turns        Turn[]
  messages     Message[]
  queuedMessages QueuedMessage[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([workspaceId, updatedAt])
}

model Turn {
  id                     String       @id
  conversationId         String
  workspaceId            String
  status                  String
  userMessage             String__LONG_TEXT__
  modelSelectionSnapshot  Json
  modelParametersSnapshot Json
  toolBindingSnapshot     Json
  instructionsSnapshot    String__LONG_TEXT__
  maxIterations           Int
  error                    Json?
  conversation             Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  steps                    Step[]
  messages                 Message[]
  createdAt                DateTime     @default(now())
  startedAt                DateTime?
  completedAt              DateTime?
  updatedAt                DateTime     @updatedAt

  @@index([conversationId, createdAt])
  @@index([status])
}

model Step {
  id               String            @id
  turnId           String
  iterationIndex   Int?
  sequence         Int
  kind             String
  status           String
  input            Json
  output           Json?
  error            Json?
  usage            Json?
  turn             Turn              @relation(fields: [turnId], references: [id], onDelete: Cascade)
  messages         Message[]
  toolConfirmations ToolConfirmation[]
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([turnId, sequence])
  @@index([turnId, iterationIndex])
}

model Message {
  id             String       @id
  conversationId String
  turnId         String
  stepId         String?
  sequence       Int
  role           String
  source         String?
  content        String__LONG_TEXT__
  toolCallId     String?
  toolId         String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  turn           Turn         @relation(fields: [turnId], references: [id], onDelete: Cascade)
  step           Step?        @relation(fields: [stepId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, sequence])
  @@index([turnId, sequence])
}

model QueuedMessage {
  id             String       @id
  conversationId String
  content        String__LONG_TEXT__
  position       Int
  status         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, position])
  @@index([conversationId, status, position])
}

model ToolConfirmation {
  id          String   @id
  stepId      String
  toolCallId  String
  toolId      String
  status      String
  arguments   Json
  decidedAt   DateTime?
  step        Step     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([stepId, toolCallId])
  @@index([status])
}
