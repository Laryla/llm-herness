{
  "name": "llm-harness",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -At run build",
    "dev": "yarn workspaces foreach -A -p -i run dev",
    "lint": "eslint .",
    "start": "yarn workspace @llm-harness/server start",
    "test": "yarn workspace @llm-harness/server db:generate && vitest run",
    "test:integration": "yarn workspace @llm-harness/server test:integration",
    "typecheck": "yarn workspaces foreach -At run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "dependenciesMeta": {
    "@prisma/engines": {
      "built": true
    },
    "better-sqlite3": {
      "built": true
    },
    "prisma": {
      "built": true
    }
  }
}
