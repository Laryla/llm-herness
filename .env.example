# Server
NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# 默认使用 ~/.llm。需要隔离数据时改为绝对路径。
# HARNESS_HOME=/absolute/path/to/.llm

# sqlite | mysql | postgresql
DATABASE_PROVIDER=sqlite

# SQLite 不需要设置，默认写入 HARNESS_HOME/data/harness.db。
# MySQL 示例：mysql://user:password@127.0.0.1:3306/llm_harness
# PostgreSQL 示例：postgresql://user:password@127.0.0.1:5432/llm_harness
# DATABASE_URL=

# 正式环境默认 50，范围 1–100；测试环境固定为 8。
MAX_ITERATIONS=50
